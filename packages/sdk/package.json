{
  "name": "@heyqr/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client and types for the hosted HeyQR REST API (v1), and an embeddable React QR preview (@heyqr/sdk/react). ESM, Node 18+.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@heyqr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "@heyqr/source": "./src/react/index.tsx",
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples/*.ts",
    "examples/sticker-layout.json"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "browser": "./dist/browser.js",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js",
        "default": "./dist/react/index.js"
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.react.build.json && node scripts/build-react.mjs && node scripts/check-entries.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.react.json && tsc --noEmit -p test/consumer && tsc --noEmit -p examples",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
