{
  "name": "@heyqr/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client and types for the hosted HeyQR REST API (v1). Update methods, retries and npm publishing come later.",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test/consumer && tsc --noEmit -p examples"
  }
}
