{
  "name": "heyqr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && pnpm --filter @heyqr/qr-core typecheck",
    "test": "vitest run",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run src/server/db",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts:metrics": "tsx packages/qr-core/scripts/caption-metrics.ts && prettier --write packages/qr-core/src/caption-metrics.ts",
    "quality": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env src/server/db/seed.ts",
    "db:verify": "tsx --env-file-if-exists=.env src/server/db/verify.ts",
    "email:dev": "email dev --dir src/server/email/templates --port 3001",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/s3-request-presigner": "3.1170.0",
    "@heyqr/qr-core": "workspace:*",
    "@hookform/resolvers": "7.0.7",
    "@react-email/components": "1.0.12",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.108.0",
    "better-auth": "1.7.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.74.0",
    "nanoid": "6.0.2",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "resend": "6.38.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "stripe": "23.1.0",
    "svg-to-pdfkit": "0.1.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "jsqr": "1.4.0",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-email": "6.11.14",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
