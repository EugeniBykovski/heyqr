# HeyQR environment variables. Copy to .env for local development (dev); never commit real values.
# Hosted values live in Vercel (Preview scope = dev, Production scope = production) and GitHub environment secrets.
# [secret] = credential, server-only.  [server] = server-only, not secret.  [public] = NEXT_PUBLIC_*, inlined into the
# browser bundle at BUILD time.  Full matrix: docs/ENVIRONMENTS.md.

# ── Environment ─────────────────────────────────────────────────────
# [server] dev | production. Leave empty locally (dev). On Vercel it follows the scope; if set, it must match it.
APP_ENV=

# ── App URLs ────────────────────────────────────────────────────────
# [public] Base URL of this environment (OAuth, Stripe and email links). dev: http://localhost:3000 or the dev domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [public] Base URL printed inside dynamic QR codes. Production: a short domain, e.g. https://hqr.to
NEXT_PUBLIC_SHORT_LINK_BASE=http://localhost:3000/r

# ── Database (docs/DATABASE.md) ─────────────────────────────────────
# [secret] dev: your local Postgres or the Neon dev branch. production: the Neon production branch (pooled endpoint).
DATABASE_URL=postgres://heyqr:heyqr@localhost:5432/heyqr
# [secret] Direct (unpooled) endpoint used by `pnpm db:migrate`; set by the Neon integration on Vercel. Optional locally.
DATABASE_URL_UNPOOLED=
# [secret] Automated tests only: `pnpm test:db` resets this database; its name must end in _test.
TEST_DATABASE_URL=postgres://heyqr:heyqr@localhost:5432/heyqr_test

# ── Sign-in: Better Auth + Google (required in every environment) ───
# [secret] Generate per environment: openssl rand -base64 32
BETTER_AUTH_SECRET=
# [server] Same origin as NEXT_PUBLIC_APP_URL. Google redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000
# [secret] One Google OAuth client per environment (dev: localhost + dev domain redirect URIs; production: production domain).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments: Stripe (optional in dev, required in production) ──────
# [secret] dev: test-mode key (sk_test_…); production: live-mode key (sk_live_…). Set all four or none in dev.
STRIPE_SECRET_KEY=
# [secret] dev: from `pnpm stripe:listen` or the dev webhook endpoint; production: the production webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# [server] Price IDs from the same Stripe mode as the key: one-time static code, monthly Dynamic plan.
STRIPE_PRICE_STATIC=
STRIPE_PRICE_DYNAMIC_MONTHLY=
# [server] Optional one-time Print Pack add-on (per code). Unset: Print Preview works, buying the Print Pack doesn't.
STRIPE_PRICE_PRINT_PACK=
# [server] Catalog (design 4.8): Stripe Price IDs per currency and offer (single, pack3, pack10, starter, studio,
# printPack), as JSON. A currency/offer without a Price ID is shown as not available to buy in that currency.
# Currencies: USD and PLN. Each Price must equal the catalog's amount and interval (src/shared/config/catalog.ts);
# checkout refuses one that differs. The display prices are fixed in that catalog, not configured here.
# Example: {"USD":{"single":"price_...","pack3":"price_...","pack10":"price_...","starter":"price_...","studio":"price_...","printPack":"price_..."},"PLN":{...}}
STRIPE_PRICES=
# [server] Active dynamic codes per plan.
DYNAMIC_ACTIVE_CODE_LIMIT=10

# ── Email: Resend (optional in dev, required in production) ─────────
# [secret] One API key per environment. Without it, dev skips receipts.
RESEND_API_KEY=
# [server] dev without a verified domain: "HeyQR <onboarding@resend.dev>" (Resend only delivers it to the address of
# the Resend account that owns the key); production: the verified production sender, e.g. "Hey QR <hello@your-domain>".
EMAIL_FROM=

# ── Storage: S3 / R2 / MinIO (optional in dev, required in production) ─
# [server] Values below are local MinIO from `docker compose up -d minio`. Use a separate bucket per environment.
S3_REGION=eu-central-1
S3_BUCKET=heyqr-local
# [secret]
S3_ACCESS_KEY_ID=heyqr
S3_SECRET_ACCESS_KEY=heyqr-secret
# [server] Leave empty for AWS. Local MinIO: http://localhost:9000 ; Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
# [server] Public base URL of the bucket (https in production).
S3_PUBLIC_URL=http://localhost:9000/heyqr-local

# ── Optional, not used by the app yet ───────────────────────────────
# [secret] Upstash Redis for rate limiting the redirect and export endpoints.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
