# ── App ─────────────────────────────────────────────────────────────
# Public base URL of the web app (used for OAuth, Stripe and email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL printed inside dynamic QR codes. Use a short domain in production, e.g. https://hqr.to
NEXT_PUBLIC_SHORT_LINK_BASE=http://localhost:3000/r

# ── Database (see docs/DATABASE.md) ────────────────────────────────
# Local: Homebrew Postgres or `pnpm db:up`. On Vercel, the Neon integration sets both URLs per environment:
# DATABASE_URL is the pooled endpoint used by the app, DATABASE_URL_UNPOOLED the direct one used by `pnpm db:migrate`.
DATABASE_URL=postgres://heyqr:heyqr@localhost:5432/heyqr
DATABASE_URL_UNPOOLED=
# local | test | preview | production. Leave empty locally; on Vercel it must match the environment (preview / production).
DATABASE_TARGET=
# Integration tests (`pnpm test:db`) reset this database; its name must end in _test.
TEST_DATABASE_URL=postgres://heyqr:heyqr@localhost:5432/heyqr_test

# ── Better Auth + Google OAuth ──────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
# From `pnpm stripe:listen` locally or the dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=whsec_
# One-time price for a static QR code and the monthly price of the Dynamic plan.
STRIPE_PRICE_STATIC=price_
STRIPE_PRICE_DYNAMIC_MONTHLY=price_
# Shown in the UI; must match the Stripe prices.
NEXT_PUBLIC_PRICE_STATIC_CENTS=499
NEXT_PUBLIC_PRICE_DYNAMIC_MONTHLY_CENTS=600
NEXT_PUBLIC_PRICE_CURRENCY=USD
DYNAMIC_ACTIVE_CODE_LIMIT=10

# ── Resend (transactional email) ────────────────────────────────────
RESEND_API_KEY=re_
EMAIL_FROM="Hey QR <hello@mail.heyqr.app>"

# ── Object storage: AWS S3 (or any S3-compatible: R2, MinIO) ────────
S3_REGION=eu-central-1
S3_BUCKET=heyqr-local
S3_ACCESS_KEY_ID=heyqr
S3_SECRET_ACCESS_KEY=heyqr-secret
# Leave empty for AWS. Local MinIO: http://localhost:9000 ; Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/heyqr-local

# ── Optional ────────────────────────────────────────────────────────
# Upstash Redis for rate limiting the redirect and export endpoints.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
